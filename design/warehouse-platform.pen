            {
              "type": "text",
              "id": "C6Ch8",
              "name": "Move mode annotation",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "MOVE MODE ANNOTATION · UX proposal, pending #7; не готовый контракт и не жест. Web хранит режим, показывает подсказку, ошибку и «Отмена»; renderer рисует preview / invalid и сообщает intent клетки. «Отмена» возвращает выбор без изменения координат. Занятая клетка — ошибка, режим остаётся. Свободная клетка завершает перемещение в черновике, сохранение — отдельно. Не drag-only; модальных форм и shortcuts нет. Способ указания клетки (клик, tap, клавиатура), drag и hit testing — R&D #7. Координаты — иллюстрация, не контракт.",
              "lineHeight": 1.45,
              "fontFamily": "$font-sans",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
