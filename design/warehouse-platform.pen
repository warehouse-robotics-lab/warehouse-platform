              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "T6SVL",
              "name": "Note body",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "«Войти» → /login (навигация, hero, финал, футер). «Как это работает» → #how. «Возможности» → #features. GitHub → https://github.com/warehouse-robotics-lab/warehouse-platform. /register не используется.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "q2cqk9",
          "name": "Note / Движение и reduced motion",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "i3EYBE",
              "name": "Note heading",
              "fill": "$foreground",
              "content": "Движение и reduced motion",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "e73hu",
              "name": "Note body",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Hero на мобильном — статичная сцена; понимание страницы не зависит от анимации. «Motion / Scroll» — сценарий из статичных кадров 0/35/70/100 %, а не доказательство работающей анимации. При prefers-reduced-motion движения нет: страница остаётся понятной без движения, как в этом макете.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "PYRM9",
          "name": "Note / Не сделано и вопросы",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "g3xzlF",
              "name": "Note heading",
              "fill": "$foreground",
              "content": "Не сделано и вопросы",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "yMStU",
              "name": "Note body",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Полная тёмная мобильная версия — после согласования композиции. EN-версия не переведена; длинные подписи проверены переносами на RU. Hover и keyboard focus на мобильном не показываются — состояния собраны в «Landing / UI Reference». Соответствие схем будущему рендеру карты не проверено. Открыто: достаточно ли «Войти» в шапке или на мобильном нужен ещё вход в редактор с главной.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
